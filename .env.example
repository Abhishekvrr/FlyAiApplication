# PostgreSQL Connection
DATABASE_URL=postgresql://cdp_admin:cdp_secure_pass@localhost:5432/cdp_platform

# Cryptographic Keys (Loaded from environment, never hardcoded)
# 32-byte hex key for Format-Preserving Encryption (FF1)
FPE_KEY=
# 8-byte hex tweak for Format-Preserving Encryption (FF1)
FPE_TWEAK=
# 32-byte base64-encoded key for AES-GCM Vault Encryption
VAULT_AES_KEY=

# Mailpit SMTP / Gateway Configuration
SMTP_HOST=localhost
SMTP_PORT=1025

# Deterministic Tokenizer Pepper / HMAC Secret
TOKEN_PEPPER=8f14e45fceea167a5a36dedd4bea2543
